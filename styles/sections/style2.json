{
    "$schema": "https:\/\/schemas.wp.org\/trunk\/theme.json",
    "version": 3,
    "slug": "section-style2",
    "title": "style2",
    "blockTypes": [
        "core\/group",
        "core\/columns",
        "core\/column",
        "core\/cover"
    ],

    "styles": {
        "color": {
            "background": "var(--wp--preset--color--contrast)",
            "text": "var(--wp--preset--color--base-3)"
        },
        "elements": {
            "button": {
                "color": {
                    "background": "var(--wp--preset--color--accent)",
                    "text": "var(--wp--preset--color--base-3)"
                }
            },
            "heading": {
                "color": {
                    "text": "var(--wp--preset--color--base-3)"
                }
            },
            "link":{
                "color": {
                    "text": "var(--wp--preset--color--base-3)"
                },
                ":hover":{
                    "color": {
                        "text": "var(--wp--preset--color--accent-1)"
                    }
                },
                "typography": {
                    "textDecoration": "none"
                  }
            }
        }
    }
}